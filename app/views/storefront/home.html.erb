<main>
<% if @banners.any? %><% hero=@banners.first %><section class="hero"><div class="hero-copy"><small>RUA VERA · ASUNCIÓN</small><h1><%= hero.title %></h1><p><%= hero.subtitle %></p><%= link_to(hero.button_text.presence || "Explorar", hero.link_url.presence || shop_path, class:"button") %></div><div class="hero-image"><%= image_tag(hero.image_url.presence || "/brand/rua-banner-moda.png", alt: hero.title) %></div></section><% else %><section class="hero"><div class="hero-copy"><small>RUA VERA · ASUNCIÓN</small><h1>Nuevas formas de descubrir.</h1><p>Moda, lifestyle, objetos y aromas seleccionados de marcas con identidad propia.</p><%= link_to "Explorar productos", shop_path, class: "button" %></div><div class="hero-image"><%= image_tag "/brand/rua-banner-moda.png", alt: "RUA Vera" %></div></section><% end %>
<% @categories.each_with_index do |category, i| %><section class="collection <%= 'alt' if i.odd? %>"><div class="section-head"><div><small>COLECCIÓN · <%= format('%02d', i + 1) %></small><h2><%= category.name %></h2><p><%= category.description.presence || "Una selección RUA de piezas y marcas con identidad." %></p></div><%= link_to "Ver toda la categoría →", shop_path(category: category.name) %></div><div class="product-grid"><% category.products.select(&:active?).first(4).each do |product| %><%= render "product_card", product: product %><% end %></div></section><% end %>
<% @banners.drop(1).each do |banner| %><section class="commercial-banner"><% if banner.image_url.present? %><%= image_tag banner.image_url, alt: banner.title %><% end %><div><small>RUA VERA</small><h2><%= banner.title %></h2><p><%= banner.subtitle %></p><%= link_to(banner.button_text.presence || "Descubrir", banner.link_url.presence || shop_path, class:"button") %></div></section><% end %>
<section class="story"><small>RUA VERA</small><h2>No se trata solo de comprar.<br>Se trata de descubrir.</h2><p>Una calle curada donde conviven marcas con identidad.</p></section>
</main>
