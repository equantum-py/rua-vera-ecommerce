<main class="pdp"><div class="pdp-image"><% if @product.image_url.present? %><%= image_tag @product.image_url, alt: @product.name %><% else %><span>RUA</span><% end %></div><div class="pdp-info"><small><%= @product.brand %></small><h1><%= @product.name %></h1><h2>Gs. <%= number_with_delimiter(@product.price, delimiter: ".") %></h2><% if @product.compare_at_price.to_i > @product.price %><p class="old-price">Antes Gs. <%= number_with_delimiter(@product.compare_at_price, delimiter: ".") %></p><% end %><p><%= @product.description %></p><p class="stock"><%= @product.stock %> unidades disponibles</p><%= form_with url: add_to_cart_path(@product), method: :post, class: "add-cart-form" do %><label>Cantidad <%= number_field_tag :quantity, 1, min: 1, max: @product.stock %></label><%= submit_tag "Agregar al carrito", class: "button" %><% end %></div></main>
