<main class="pdp"><div class="pdp-image"><% if @product.image_url.present? %><%= image_tag @product.image_url, alt: @product.name %><% else %><span>RUA</span><% end %></div><div class="pdp-info"><small><%= @product.brand %></small><h1><%= @product.name %></h1><% if @product.active_promotion %><span class="promo-pill"><%= @product.active_promotion.name %> · -<%= @product.active_promotion.discount_percent %>%</span><% end %><h2>Gs. <%= number_with_delimiter(@product.selling_price, delimiter: ".") %></h2><% if @product.selling_price < @product.price %><p class="old-price">Antes Gs. <%= number_with_delimiter(@product.price, delimiter: ".") %></p><% end %><p><%= @product.description %></p><p class="stock"><%= @product.available_stock %> unidades disponibles</p><% if @product.available_stock > 0 %><%= form_with url: add_to_cart_path(@product), method: :post, class: "add-cart-form" do %><% variants=@product.product_variants.where(active:true).where("stock > 0") %><% if variants.any? %><label>Elegí talle / color <%= select_tag :variant_id, options_from_collection_for_select(variants, :id, :display_name), prompt: "Seleccionar variante", required: true %></label><% end %><label>Cantidad <%= number_field_tag :quantity, 1, min: 1, max: @product.available_stock %></label><%= submit_tag "Agregar al carrito", class: "button" %><% end %><% else %><button class="button sold-button" disabled>Producto agotado</button><% end %></div></main>
