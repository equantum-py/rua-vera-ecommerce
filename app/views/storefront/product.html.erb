<main class="pdp"><div class="pdp-image"><% if @product.image_url.present? %><%= image_tag @product.image_url, alt: @product.name %><% else %><span>RUA</span><% end %></div><div class="pdp-info"><small><%= @product.brand %></small><h1><%= @product.name %></h1><h2>Gs. <%= number_with_delimiter(@product.price, delimiter: ".") %></h2><p><%= @product.description %></p><p class="stock"><%= @product.stock %> unidades disponibles</p><button class="button">Agregar al carrito</button></div></main>
