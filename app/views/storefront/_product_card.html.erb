<%= link_to product_path(product), class: "product-card" do %><div class="product-image"><% if product.image_url.present? %><%= image_tag product.image_url, alt: product.name %><% else %><span>RUA</span><% end %><% if product.compare_at_price.to_i > product.price.to_i %><b>-<%= (((product.compare_at_price-product.price).to_f/product.compare_at_price)*100).round %>%</b><% end %></div><small><%= product.brand %></small><h3><%= product.name %></h3><p>Gs. <%= number_with_delimiter(product.price, delimiter: ".") %></p><% end %>
