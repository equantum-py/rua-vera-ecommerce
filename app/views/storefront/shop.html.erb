<main class="shop"><div class="shop-title"><small>RUA VERA · TIENDA</small><h1><%= params[:category].presence || "Todos los productos" %></h1></div><div class="filters"><%= link_to "Todos", shop_path %><% @categories.each do |category| %><%= link_to category.name, shop_path(category: category.name) %><% end %></div><div class="product-grid"><%= render partial: "product_card", collection: @products, as: :product %></div></main>
