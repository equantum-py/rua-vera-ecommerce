<main class="cart-page"><div class="checkout-title"><small>RUA VERA · CARRITO</small><h1>Tu selección</h1></div><% if notice %><p class="flash"><%= notice %></p><% end %><% if @items.any? %><div class="cart-layout"><section><% @items.each do |product, quantity| %><article class="cart-item"><div class="cart-thumb"><% if product.image_url.present? %><%= image_tag product.image_url, alt: product.name %><% else %><span>RUA</span><% end %></div><div class="cart-data"><small><%= product.brand %></small><h2><%= product.name %></h2><p>Gs. <%= number_with_delimiter(product.price, delimiter: ".") %></p><%= form_with url: update_cart_path(product), method: :patch, class: "quantity-form" do %><label>Cantidad <%= number_field_tag :quantity, quantity, min: 1, max: product.stock %></label><%= submit_tag "Actualizar" %><% end %><%= button_to "Quitar", remove_cart_path(product), method: :delete, class: "link-button" %></div></article><% end %></section><aside class="cart-summary"><small>RESUMEN</small><h2>Subtotal</h2><strong>Gs. <%= number_with_delimiter(@subtotal, delimiter: ".") %></strong><p>El envío se define en el siguiente paso.</p><%= link_to "Continuar al checkout", checkout_path, class: "button" %><%= link_to "Seguir comprando", shop_path, class: "continue-link" %></aside></div><% else %><div class="empty-cart"><h2>Tu carrito está vacío.</h2><%= link_to "Explorar productos", shop_path, class: "button" %></div><% end %></main>