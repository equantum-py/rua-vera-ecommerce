<main class="cart-page"><div class="checkout-title"><small>RUA VERA · CARRITO</small><h1>Tu selección</h1></div><% if notice %><p class="flash"><%= notice %></p><% end %><% if alert %><p class="flash"><%= alert %></p><% end %><% if @items.any? %><div class="cart-layout"><section><% @items.each do |item| %><% product=item[:product]; variant=item[:variant]; quantity=item[:quantity] %><article class="cart-item"><div class="cart-thumb"><% if product.image_url.present? %><%= image_tag product.image_url, alt: product.name %><% else %><span>RUA</span><% end %></div><div class="cart-data"><small><%= product.brand %></small><h2><%= product.name %></h2><% if variant %><p class="variant-label"><%= variant.display_name %></p><% end %><p>Gs. <%= number_with_delimiter(item[:unit_price], delimiter: ".") %></p><%= form_with url: update_cart_path(item[:key]), method: :patch, class: "quantity-form" do %><label>Cantidad <%= number_field_tag :quantity, quantity, min: 1, max: (variant ? variant.stock : product.stock) %></label><%= submit_tag "Actualizar" %><% end %><%= button_to "Quitar", remove_cart_path(item[:key]), method: :delete, class: "link-button" %></div></article><% end %></section><aside class="cart-summary"><small>RESUMEN</small><h2>Subtotal</h2><strong>Gs. <%= number_with_delimiter(@subtotal, delimiter: ".") %></strong><p>Promociones vigentes aplicadas automáticamente.</p><%= link_to "Continuar al checkout", checkout_path, class: "button" %><%= link_to "Seguir comprando", shop_path, class: "continue-link" %></aside></div><% else %><div class="empty-cart"><h2>Tu carrito está vacío.</h2><%= link_to "Explorar productos", shop_path, class: "button" %></div><% end %></main>