<main class="admin"><div class="admin-heading"><div><small>RUA VERA · INVENTARIO</small><h1>Inventario</h1><p><%= @low_stock.size %> productos con stock bajo.</p></div></div><div class="admin-table-wrap"><table class="admin-table"><thead><tr><th>Producto</th><th>Categoría</th><th>Stock</th><th>Actualizar</th></tr></thead><tbody><% @products.each do |product| %><tr><td><strong><%= product.name %></strong><small><%= product.sku %></small></td><td><%= product.category.name %></td><td><span class="<%= 'stock-low' if product.stock <= 5 %>"><%= product.stock %></span></td><td><%= form_with url: admin_inventory_path(product), method: :patch, class: "stock-form" do %><%= number_field_tag :stock, product.stock, min: 0 %><%= submit_tag "Guardar" %><% end %></td></tr><% end %></tbody></table></div></main>