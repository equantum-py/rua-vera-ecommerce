<main class="admin-login"><div><small>RUA VERA · ADMINISTRACIÓN</small><h1>Acceso privado</h1><p>Ingresá con tu cuenta administrativa.</p><% if alert %><p class="flash"><%= alert %></p><% end %><%= form_with url: admin_login_path, class: "admin-form" do %><label>Email<%= email_field_tag :email, nil, required: true, autocomplete: "username" %></label><label>Contraseña<%= password_field_tag :password, nil, required: true, autocomplete: "current-password" %></label><%= submit_tag "Ingresar", class: "button" %><% end %></div></main>