<main class="admin"><small>RUA VERA · CLIENTE</small><h1><%= @customer.name %></h1><p><%= @customer.email %> · <%= @customer.phone %> · <%= @customer.document %></p><div class="stats"><article><b><%= @customer.orders_count %></b><span>Pedidos</span></article><article><b>Gs. <%= number_with_delimiter(@customer.total_spent, delimiter: ".") %></b><span>Total comprado</span></article></div><h2 class="admin-section-title">Historial</h2><div class="admin-table-wrap"><table class="admin-table"><% @orders.each do |order| %><tr><td><%= link_to order.number, admin_order_path(order) %></td><td><%= order.status %></td><td>Gs. <%= number_with_delimiter(order.total, delimiter: ".") %></td></tr><% end %></table></div></main>