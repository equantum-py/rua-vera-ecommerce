<%= form_with model: [:admin, banner], class: "admin-form" do |f| %><div class="form-grid"><label>Título<%= f.text_field :title, required: true %></label><label>Subtítulo<%= f.text_field :subtitle %></label><label>Imagen<%= f.text_field :image_url, placeholder: "/brand/banner.png" %></label><label>Enlace<%= f.text_field :link_url, placeholder: "/shop" %></label><label>Texto del botón<%= f.text_field :button_text, placeholder: "Explorar" %></label><label>Posición<%= f.number_field :position, min: 0 %></label><label class="check"><%= f.check_box :active %> Banner activo</label></div><div class="form-actions"><%= f.submit "Guardar banner", class: "button" %><%= link_to "Cancelar", admin_banners_path %></div><% end %>