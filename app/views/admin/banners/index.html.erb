<main class="admin"><div class="admin-heading"><div><small>RUA VERA · BANNERS</small><h1>Banners</h1><p>Administrá las piezas comerciales de la tienda.</p></div><%= link_to "Nuevo banner", new_admin_banner_path, class: "button" %></div><div class="category-admin-grid"><% @banners.each do |banner| %><article><small>POSICIÓN <%= banner.position %> · <%= banner.active? ? "ACTIVO" : "OCULTO" %></small><h2><%= banner.title %></h2><p><%= banner.subtitle %></p><div class="actions"><%= link_to "Editar", edit_admin_banner_path(banner) %><%= button_to "Eliminar", admin_banner_path(banner), method: :delete, class: "link-button" %></div></article><% end %></div></main>