<main class="admin"><small>RUA VERA · PEDIDOS</small><h1>Pedidos</h1><div class="admin-table-wrap"><table class="admin-table"><thead><tr><th>Pedido</th><th>Cliente</th><th>Total</th><th>Pago</th><th>Estado</th><th></th></tr></thead><tbody><% @orders.each do |order| %><tr><td><%= order.number || "##{order.id}" %></td><td><strong><%= order.customer_name %></strong><small><%= order.customer_email %></small></td><td>Gs. <%= number_with_delimiter(order.total, delimiter: ".") %></td><td><%= order.payment_status %></td><td><span class="status"><%= order.status %></span></td><td><%= link_to "Ver", admin_order_path(order) %></td></tr><% end %></tbody></table></div></main>