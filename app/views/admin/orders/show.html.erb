<main class="admin form-page"><small>RUA VERA · PEDIDO</small><h1><%= @order.number || "Pedido ##{@order.id}" %></h1><p><strong><%= @order.customer_name %></strong><br><%= @order.customer_email %></p><%= form_with model: [:admin, @order], class: "admin-form" do |f| %><div class="form-grid"><label>Estado<%= f.select :status, [["Pendiente","pending"],["Confirmado","confirmed"],["Preparando","preparing"],["Enviado","shipped"],["Entregado","delivered"],["Cancelado","cancelled"]] %></label><label>Pago<%= f.select :payment_status, [["Pendiente","pending"],["Pagado","paid"],["Rechazado","failed"],["Reembolsado","refunded"]] %></label><label>Referencia ERP<%= f.text_field :erp_reference %></label></div><%= f.submit "Actualizar pedido", class: "button" %><% end %></main>