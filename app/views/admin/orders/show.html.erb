<main class="admin"><small>RUA VERA · PEDIDO</small><h1><%= @order.number || "Pedido ##{@order.id}" %></h1><div class="order-admin-grid"><section><h2>Cliente</h2><p><strong><%= @order.customer_name %></strong><br><%= @order.customer_email %><br><%= @order.customer_phone %><br>Cédula/RUC: <%= @order.customer_document %></p><h2>Entrega</h2><p><%= @order.delivery_method == "pickup" ? "Retiro en RUA" : "Envío a domicilio" %><br><%= @order.delivery_address %></p><h2>Productos</h2><% @order.order_items.each do |item| %><div class="order-line"><span><strong><%= item.product_name %></strong><% if item.variant_name.present? %><small><%= item.variant_name %></small><% end %><small><%= item.sku %> · <%= item.quantity %> unidad(es)</small></span><strong>Gs. <%= number_with_delimiter(item.unit_price * item.quantity, delimiter: ".") %></strong></div><% end %><div class="summary-total"><span>Total</span><strong>Gs. <%= number_with_delimiter(@order.total, delimiter: ".") %></strong></div></section><aside><%= form_with model: [:admin, @order], class: "admin-form" do |f| %><div class="form-grid one-column"><label>Estado<%= f.select :status, [["Pendiente","pending"],["Confirmado","confirmed"],["Preparando","preparing"],["Enviado","shipped"],["Entregado","delivered"],["Cancelado","cancelled"]] %></label><label>Pago<input value="<%= @order.payment_status %>" disabled><small>El estado de pago se actualiza únicamente desde la integración de pagos.</small></label><label>Referencia ERP<%= f.text_field :erp_reference %></label></div><%= f.submit "Actualizar pedido", class: "button" %><% end %></aside></div></main>