<main class="admin"><div class="admin-heading"><div><small>RUA VERA · CATEGORÍAS</small><h1>Categorías</h1><p>Organizá los productos por universo RUA.</p></div><%= link_to "Nueva categoría", new_admin_category_path, class: "button" %></div><div class="category-admin-grid"><% @categories.each do |category| %><article><small><%= category.products.size %> productos</small><h2><%= category.name %></h2><p><%= category.description %></p><div class="actions"><%= link_to "Editar", edit_admin_category_path(category) %><%= button_to "Eliminar", admin_category_path(category), method: :delete, class: "link-button" %></div></article><% end %></div></main>