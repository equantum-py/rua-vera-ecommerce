<%= form_with model: [:admin, category], class: "admin-form" do |f| %><div class="form-grid"><label>Nombre<%= f.text_field :name, required: true %></label><label>Slug<%= f.text_field :slug, placeholder: "Se genera automáticamente" %></label><label class="wide">Descripción<%= f.text_area :description, rows: 5 %></label></div><div class="form-actions"><%= f.submit "Guardar categoría", class: "button" %><%= link_to "Cancelar", admin_categories_path %></div><% end %>