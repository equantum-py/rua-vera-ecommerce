<main class="admin"><div class="admin-heading"><div><small>RUA VERA · VARIANTES</small><h1><%= @product.name %></h1><p>Talles, colores, precio opcional y stock independiente.</p></div><%= link_to "Nueva variante", new_admin_product_product_variant_path(@product), class: "button" %></div><div class="admin-table-wrap"><table class="admin-table"><thead><tr><th>SKU</th><th>Talle</th><th>Color</th><th>Precio</th><th>Stock</th><th>Estado</th><th></th></tr></thead><tbody><% @variants.each do |variant| %><tr><td><%= variant.sku %></td><td><%= variant.size.presence || "—" %></td><td><%= variant.color.presence || "—" %></td><td>Gs. <%= number_with_delimiter(variant.effective_price, delimiter: ".") %></td><td><%= variant.stock %></td><td><span class="status"><%= variant.active? ? "Activa" : "Oculta" %></span></td><td class="actions"><%= link_to "Editar", edit_admin_product_product_variant_path(@product, variant) %><%= button_to "Eliminar", admin_product_product_variant_path(@product, variant), method: :delete, class: "link-button" %></td></tr><% end %></tbody></table></div><%= link_to "← Volver a productos", admin_products_path, class: "continue-link" %></main>