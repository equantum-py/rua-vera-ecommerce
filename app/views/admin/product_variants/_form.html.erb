<%= form_with model: [:admin, product, variant], class: "admin-form" do |f| %><div class="form-grid"><label>SKU variante<%= f.text_field :sku, required: true %></label><label>Talle<%= f.text_field :size, placeholder: "S, M, L, XL..." %></label><label>Color<%= f.text_field :color, placeholder: "Crudo, Negro..." %></label><label>Precio especial<%= f.number_field :price, min: 0, placeholder: "Vacío = precio del producto" %></label><label>Stock<%= f.number_field :stock, min: 0, required: true %></label><label class="check"><%= f.check_box :active %> Variante activa</label></div><div class="form-actions"><%= f.submit "Guardar variante", class: "button" %><%= link_to "Cancelar", admin_product_product_variants_path(product) %></div><% end %>