<main class="admin"><div class="admin-heading"><div><small>RUA VERA · PROMOCIONES</small><h1>Promociones</h1><p>Descuentos automáticos por categoría y período.</p></div><%= link_to "Nueva promoción", new_admin_promotion_path, class: "button" %></div><div class="admin-table-wrap"><table class="admin-table"><thead><tr><th>Promoción</th><th>Descuento</th><th>Categoría</th><th>Vigencia</th><th>Estado</th><th></th></tr></thead><tbody><% @promotions.each do |promotion| %><tr><td><strong><%= promotion.name %></strong></td><td><%= promotion.discount_percent %>%</td><td><%= promotion.category&.name || "Toda la tienda" %></td><td><small><%= promotion.starts_at&.strftime("%d/%m/%Y") || "Ahora" %> → <%= promotion.ends_at&.strftime("%d/%m/%Y") || "Sin límite" %></small></td><td><span class="status"><%= promotion.active_now? ? "Activa" : "Inactiva" %></span></td><td class="actions"><%= link_to "Editar", edit_admin_promotion_path(promotion) %><%= button_to "Eliminar", admin_promotion_path(promotion), method: :delete, class: "link-button" %></td></tr><% end %></tbody></table></div></main>