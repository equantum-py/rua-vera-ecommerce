<%= form_with model: [:admin, promotion], class: "admin-form" do |f| %><div class="form-grid"><label>Nombre<%= f.text_field :name, required: true %></label><label>Descuento %<%= f.number_field :discount_percent, min: 1, max: 100, required: true %></label><label>Categoría<%= f.collection_select :category_id, Category.order(:name), :id, :name, { include_blank: "Toda la tienda" } %></label><label>Inicio<%= f.datetime_local_field :starts_at %></label><label>Fin<%= f.datetime_local_field :ends_at %></label><label class="check"><%= f.check_box :active %> Promoción activa</label></div><div class="form-actions"><%= f.submit "Guardar promoción", class: "button" %><%= link_to "Cancelar", admin_promotions_path %></div><% end %>