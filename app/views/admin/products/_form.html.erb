<%= form_with model: [:admin, product], class: "admin-form" do |f| %><% if product.errors.any? %><div class="form-errors"><%= product.errors.full_messages.join(" · ") %></div><% end %><div class="form-grid"><label>Nombre<%= f.text_field :name, required: true %></label><label>SKU<%= f.text_field :sku, required: true %></label><label>Marca<%= f.text_field :brand %></label><label>Categoría<%= f.collection_select :category_id, Category.order(:name), :id, :name %></label><label>Precio (Gs.)<%= f.number_field :price, min: 0, required: true %></label><label>Precio anterior<%= f.number_field :compare_at_price, min: 0 %></label><label>Stock<%= f.number_field :stock, min: 0 %></label><label>URL de imagen<%= f.text_field :image_url, placeholder: "/brand/producto.png" %></label><label class="wide">Descripción<%= f.text_area :description, rows: 5 %></label><label class="check"><%= f.check_box :active %> Producto visible en la tienda</label></div><div class="form-actions"><%= f.submit "Guardar producto", class: "button" %><%= link_to "Cancelar", admin_products_path %></div><% end %>