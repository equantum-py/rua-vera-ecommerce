<main class="admin"><div class="admin-heading"><div><small>RUA VERA · PRODUCTOS</small><h1>Productos</h1><p>Gestioná catálogo, precios, descuentos, stock e imágenes.</p></div><%= link_to "Nuevo producto", new_admin_product_path, class: "button" %></div><% if notice %><p class="flash"><%= notice %></p><% end %><div class="admin-table-wrap"><table class="admin-table"><thead><tr><th>Producto</th><th>Categoría</th><th>Precio</th><th>Stock</th><th>Estado</th><th></th></tr></thead><tbody><% @products.each do |product| %><tr><td><strong><%= product.name %></strong><small><%= product.brand %> · <%= product.sku %></small></td><td><%= product.category.name %></td><td>Gs. <%= number_with_delimiter(product.price, delimiter: ".") %><% if product.compare_at_price.to_i > product.price %><small>Antes Gs. <%= number_with_delimiter(product.compare_at_price, delimiter: ".") %></small><% end %></td><td><%= product.stock %></td><td><span class="status"><%= product.active? ? "Activo" : "Oculto" %></span></td><td class="actions"><%= link_to "Variantes", admin_product_product_variants_path(product) %><%= link_to "Editar", edit_admin_product_path(product) %><%= button_to "Eliminar", admin_product_path(product), method: :delete, form: { data: { turbo_confirm: "¿Eliminar #{product.name}?" } }, class: "link-button" %></td></tr><% end %></tbody></table></div></main>